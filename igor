#!/usr/bin/env bash
#
# igor - conductor for building a Puppet Enterprise demo environment.
#
# ./igor is the driver (see DRIVER-DESIGN.md). It runs the charter's stages in
# order and calls the tool that fits each: tofu for provisioning, goodmountain's
# template builder over SSH, git/gh for the control repo, and Bolt only for the
# node-configuration stages (PE, infra roles, agents). Each stage is also
# individually invocable for debugging and demos.
#
# Usage:
#   ./igor deploy       - run all stages in order (accepts gating flags)
#   ./igor templates    - stage 1: build Proxmox templates
#   ./igor provision    - stage 2: tofu apply (VMs + DNS)
#   ./igor control-repo - stage 3: bootstrap the control repo
#   ./igor pe           - stage 4: build Puppet Enterprise
#   ./igor client-tools - stage 5: CA cert, console login, client config
#   ./igor infra        - stage 6: build infrastructure roles
#   ./igor agents       - stage 8: build agent nodes
#   ./igor setup        - interactive first-time configuration
#   ./igor destroy      - tear down the environment
#   ./igor reset        - remove generated config
#   ./igor preflight    - validate prerequisites
#   ./igor status       - show environment status
#   ./igor help         - show this help

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

PROVIDER="${IGOR_PROVIDER:-proxmox}"
PROVIDER_DIR="tf/providers/${PROVIDER}"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

banner() {
	echo ""
	echo -e "${BLUE}  _                  ${NC}"
	echo -e "${BLUE} (_) __ _  ___  _ __ ${NC}"
	echo -e "${BLUE} | |/ _\` |/ _ \\| '__|${NC}"
	echo -e "${BLUE} | | (_| | (_) | |   ${NC}"
	echo -e "${BLUE} |_|\\__, |\\___/|_|   ${NC}"
	echo -e "${BLUE}    |___/            ${NC}"
	echo ""
}

info() { echo -e "${GREEN}[info]${NC}  $*"; }
warn() { echo -e "${YELLOW}[warn]${NC}  $*"; }
error() { echo -e "${RED}[error]${NC} $*" >&2; }

require_cmd() {
	if ! command -v "$1" >/dev/null 2>&1; then
		error "Required command not found: $1"
		return 1
	fi
}

check_bolt() {
	if ! command -v bolt >/dev/null 2>&1; then
		error "Bolt is not installed."
		echo "  Install: https://www.puppet.com/docs/bolt/latest/bolt_installing"
		exit 1
	fi
}

ensure_modules() {
	if [ ! -d ".modules" ]; then
		info "Installing Bolt modules (first run)..."
		bolt module install
	fi
}

# Secrets come from the environment and nowhere else. TF_VAR_* are read by
# tofu, AWS_* by the S3 state backend.
SECRET_VARS=(
	TF_VAR_proxmox_token_secret
	TF_VAR_cipassword
	TF_VAR_console_password
	AWS_ACCESS_KEY_ID
	AWS_SECRET_ACCESS_KEY
)

# Fail early, naming every missing variable, rather than letting tofu prompt
# for them or fail halfway through an apply.
require_vars() {
	local v missing=()
	for v in "$@"; do
		[ -n "${!v:-}" ] || missing+=("$v")
	done
	if [ "${#missing[@]}" -gt 0 ]; then
		error "These environment variables must be set:"
		printf '          %s\n' "${missing[@]}" >&2
		return 1
	fi
}

# Read a value from terraform.tfvars (non-secret config only).
tfvar() {
	awk -F'"' -v k="$1" '$0 ~ "^[[:space:]]*"k"[[:space:]]*=" {print $2; exit}' \
		"${PROVIDER_DIR}/terraform.tfvars" 2>/dev/null
}

# Run tofu in the provider dir. Secrets reach it through the environment.
tofu_run() {
	require_cmd tofu
	require_vars "${SECRET_VARS[@]}"
	(cd "$PROVIDER_DIR" && tofu "$@")
}

# True if the given tofu tag has at least one VM in state.
role_has_targets() {
	local tag="$1" out count
	out="$(PT_provider="$PROVIDER" PT_tag_filter="$tag" ./tasks/tofu_inventory.sh 2>/dev/null || echo '{"value":[]}')"
	count="$(printf '%s' "$out" | jq '.value | length' 2>/dev/null || echo 0)"
	[ "${count:-0}" -gt 0 ]
}

# ---------------------------------------------------------------------------
# Stages
# ---------------------------------------------------------------------------

# Stage 1: build Proxmox templates on the hypervisor host.
# The builder lives in its own repo, goodmountain, expected as a sibling
# checkout (override with GOODMOUNTAIN_DIR). Conditional: skips existing
# templates unless force_rebuild, so a warm host pays almost nothing. Also
# runnable on its own via `./igor templates`.
stage_templates() {
	local force="${1:-false}"
	info "Stage 1: Proxmox templates"
	require_vars TF_VAR_cipassword
	require_cmd ssh
	require_cmd scp

	local host user storage workdir gm
	host="${PVE_HOST:-$(tfvar api_url | sed -E 's#^https?://([^:/]+).*#\1#')}"
	user="${PVE_USER:-root}"
	storage="${STORAGE:-ceph}"
	workdir="${PVE_WORKDIR:-/root/templates}"
	gm="${GOODMOUNTAIN_DIR:-${SCRIPT_DIR}/../goodmountain}"

	if [ -z "$host" ]; then
		error "No Proxmox host. Set PVE_HOST, or ensure api_url is in terraform.tfvars."
		return 1
	fi

	if [ ! -f "${gm}/template-generate.sh" ]; then
		error "goodmountain not found at ${gm}. Clone it alongside igor, or set GOODMOUNTAIN_DIR."
		return 1
	fi

	info "  host=${host} user=${user} storage=${storage} force_rebuild=${force}"
	# The remote command strings intentionally expand workdir/force/storage on
	# the client before being sent to the host (SC2029 is expected here).
	# shellcheck disable=SC2029
	ssh -o StrictHostKeyChecking=no "${user}@${host}" "mkdir -p '${workdir}'"
	scp -q "${gm}/template-generate.sh" "${gm}/template-clean.sh" "${gm}/templates.csv" \
		"${user}@${host}:${workdir}/"
	# Write the password file the script reads via `cat ./config`, via stdin so
	# it never lands on the process list.
	# TF_VAR_cipassword comes from the environment (checked by require_vars).
	# shellcheck disable=SC2029,SC2154
	printf '%s' "$TF_VAR_cipassword" | ssh "${user}@${host}" "umask 077 && cat > '${workdir}/config'"
	# shellcheck disable=SC2029
	ssh "${user}@${host}" "cd '${workdir}' && FORCE_REBUILD='${force}' STORAGE='${storage}' sh ./template-generate.sh"
	# shellcheck disable=SC2029
	ssh "${user}@${host}" "rm -f '${workdir}/config'"
	info "  templates ready"
}

# Stage 2: provision VMs and DNS with tofu.
stage_provision() {
	info "Stage 2: Provision infrastructure (tofu apply)"
	tofu_run apply -auto-approve
	info "  infrastructure provisioned"
}

# Stage 3: bootstrap the control repo on GitHub (git/gh).
# Runs before stage_pe so Code Manager has a repo to deploy from during the PE
# build. Still invokes the Bolt plan for now; a bash reimplementation follows the
# secrets migration (the plan reads r10k_remote and config from hiera today).
stage_control_repo() {
	info "Stage 3: Control repo"
	check_bolt
	ensure_modules
	bolt plan run igor::bootstrap_control_repo push=true
	info "  control repo bootstrapped"
}

# Stage 4: build the PE primary (pure node config).
stage_pe() {
	info "Stage 4: Puppet Enterprise"
	check_bolt
	ensure_modules
	bolt plan run igor::build_pe
	info "  PE primary ready"
}

# Stage 5: local Puppet client tools (CA cert, console login, tool config).
# Runs after stage_pe (needs PE up). Still invokes the Bolt plans, which read
# config and the console password from eyaml hiera; a bash reimplementation
# follows.
stage_client_tools() {
	info "Stage 5: Client tools"
	check_bolt
	ensure_modules
	bolt plan run igor::fetch_ca_cert
	bolt plan run igor::puppet_access_login
	bolt plan run igor::configure_client_tools
	info "  client tools configured"
}

# Stage 6: build each infrastructure role that has VMs in state.
stage_infra() {
	info "Stage 6: Infrastructure roles"
	check_bolt
	ensure_modules
	local role built=false
	for role in scm cd4pe dashboard; do
		if role_has_targets "$role"; then
			info "  building ${role}..."
			bolt plan run igor::build_infra_node role="$role"
			built=true
		fi
	done
	if [ "$built" = false ]; then
		info "  no infrastructure roles in tofu state, skipping"
	fi
}

# Stage 8: build agent nodes if any exist.
stage_agents() {
	info "Stage 8: Agent nodes"
	if role_has_targets puppetagents; then
		check_bolt
		ensure_modules
		bolt plan run igor::build_agents
		info "  agents built"
	else
		info "  no agents in tofu state, skipping"
	fi
}

# Stage 9: deploy control repo code.
stage_code_deploy() {
	info "Stage 9: Deploy control repo code"
	if command -v puppet-code >/dev/null 2>&1; then
		puppet-code deploy production --wait
		info "  production code deployed"
	else
		warn "  puppet-code not found, skipping (build_pe already deploys via code_manager)"
	fi
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_deploy() {
	local build_templates=true apply_terraform=true force_rebuild=false arg
	for arg in "$@"; do
		case "$arg" in
		build_templates=*) build_templates="${arg#*=}" ;;
		apply_terraform=*) apply_terraform="${arg#*=}" ;;
		force_rebuild=*) force_rebuild="${arg#*=}" ;;
		*)
			error "Unknown deploy option: ${arg}"
			exit 1
			;;
		esac
	done

	banner
	info "Deploying Igor environment"
	echo ""

	check_bolt
	ensure_modules
	bolt plan run igor::preflight
	echo ""

	if [ "$build_templates" = true ]; then
		stage_templates "$force_rebuild"
	else
		info "Stage 1: skipping template build (build_templates=false)"
	fi
	echo ""

	if [ "$apply_terraform" = true ]; then
		stage_provision
	else
		info "Stage 2: skipping provisioning (apply_terraform=false)"
	fi
	echo ""

	stage_control_repo
	echo ""
	stage_pe
	echo ""
	stage_client_tools
	echo ""
	stage_infra
	echo ""
	stage_agents
	echo ""
	stage_code_deploy

	echo ""
	info "=== Environment build complete ==="
}

cmd_setup() {
	banner
	info "Starting Igor setup wizard..."
	echo ""
	require_cmd ruby
	check_bolt
	ensure_modules
	exec ruby "${SCRIPT_DIR}/scripts/igor-setup.rb" "$@"
}

cmd_destroy() {
	banner
	warn "Destroying Igor environment..."
	echo ""
	check_bolt
	ensure_modules
	bolt plan run igor::destroy_environment "$@"
}

cmd_reset() {
	banner
	warn "Resetting Igor configuration..."
	echo ""
	check_bolt
	ensure_modules
	bolt plan run igor::reset "$@"
}

cmd_preflight() {
	banner
	info "Running preflight checks..."
	echo ""
	check_bolt
	ensure_modules
	bolt plan run igor::preflight "$@"
}

cmd_status() {
	banner
	info "Checking environment status..."
	echo ""
	check_bolt
	ensure_modules
	bolt plan run igor::status "$@"
}

cmd_help() {
	banner
	echo "Usage: ./igor <command> [options]"
	echo ""
	echo "Full build:"
	echo "  deploy     Run the deploy stages in order"
	echo "             Options: build_templates=false  (skip Proxmox template build)"
	echo "                      apply_terraform=false  (skip VM provisioning)"
	echo "                      force_rebuild=true     (rebuild existing templates)"
	echo ""
	echo "Deploy stages (individually invocable for debugging and demos):"
	echo "  templates     Stage 1: build Proxmox templates on the host"
	echo "  provision     Stage 2: tofu apply (VMs + DNS)"
	echo "  control-repo  Stage 3: bootstrap the control repo on GitHub"
	echo "  pe            Stage 4: build Puppet Enterprise"
	echo "  client-tools  Stage 5: CA cert, console login, client tool config"
	echo "  infra         Stage 6: build infrastructure roles (scm, cd4pe, dashboard)"
	echo "  agents        Stage 8: build agent nodes"
	echo ""
	echo "Lifecycle:"
	echo "  setup      Interactive first-time configuration"
	echo "  preflight  Validate prerequisites"
	echo "  status     Show environment status"
	echo "  destroy    Tear down the environment  (confirm=true to proceed)"
	echo "  reset      Remove generated config     (confirm=true to proceed)"
	echo "  help       Show this help"
	echo ""
	echo "Typical workflow:"
	echo "  1. ./igor setup"
	echo "  2. ./igor preflight"
	echo "  3. ./igor deploy"
	echo ""
}

# Main dispatch
case "${1:-help}" in
deploy)
	shift
	cmd_deploy "$@"
	;;
templates)
	shift
	_force=false
	for _a in "$@"; do
		case "$_a" in
		force_rebuild=*) _force="${_a#*=}" ;;
		esac
	done
	stage_templates "$_force"
	;;
provision)
	shift
	stage_provision
	;;
control-repo)
	shift
	stage_control_repo
	;;
pe)
	shift
	stage_pe
	;;
client-tools)
	shift
	stage_client_tools
	;;
infra)
	shift
	stage_infra
	;;
agents)
	shift
	stage_agents
	;;
setup)
	shift
	cmd_setup "$@"
	;;
destroy)
	shift
	cmd_destroy "$@"
	;;
reset)
	shift
	cmd_reset "$@"
	;;
preflight)
	shift
	cmd_preflight "$@"
	;;
status)
	shift
	cmd_status "$@"
	;;
help | -h | --help) cmd_help ;;
*)
	error "Unknown command: $1"
	echo ""
	cmd_help
	exit 1
	;;
esac
