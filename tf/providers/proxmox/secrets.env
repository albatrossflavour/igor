# Terraform secret injection for `op run` (see DRIVER-DESIGN.md).
#
# These are op:// REFERENCES, not secrets, so this file is safe to commit.
# The driver runs `op run --env-file=secrets.env -- tofu ...` so the resolved
# values only ever exist in the tofu subprocess environment, never on disk.
#
# `./igor setup` creates these items in the `igor` vault if they are
# missing. TF_VAR_* names must match the sensitive variables in variables.tf.

TF_VAR_proxmox_token_secret=op://igor/proxmox-credentials/token_secret
TF_VAR_cipassword=op://igor/proxmox-credentials/cipassword
TF_VAR_console_password=op://igor/pe-credentials/console_password
TF_VAR_pihole_password=op://igor/pihole-credentials/password

# S3 state backend credentials (used at `tofu init` and on every apply)
AWS_ACCESS_KEY_ID=op://igor/aws-s3-backend/access_key_id
AWS_SECRET_ACCESS_KEY=op://igor/aws-s3-backend/secret_access_key
